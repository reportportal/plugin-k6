# All settings as environment variables, one per line, no quotes.
# Works with both:
#   docker run --env-file examples/reportportal.env ...
#   set -a; . examples/reportportal.env; set +a
# Copy to reportportal.env and fill in the three required values. Do not commit a real token.

# Required: base URL (no /ui or /api/v1), project slug (not the numeric id), API token.
RP_ENDPOINT=https://rp.example.com
RP_PROJECT=my_project
RP_API_KEY=your_api_token_here

# Launch name. Defaults to the script file name.
RP_LAUNCH=checkout-load-test

# SLA quality gate. Remove a line to disable that check.
RP_SLA_P95_MS=800
RP_SLA_P99_MS=1500
RP_SLA_ERROR_RATE_PCT=1
RP_SLA_MIN_THROUGHPUT_RPS=50
RP_SLA_MIN_PEAK_THROUGHPUT_RPS=80

# Peak throughput is measured in a sliding window of this many seconds. Default 1.
RP_THROUGHPUT_WINDOW_SECONDS=5

# Leave matching request labels out of the report (unanchored regular expressions).
RP_SAMPLE_EXCLUDE_REGEX=health|ping
# RP_SAMPLE_INCLUDE_REGEX=^(Checkout|Browse)

# Up to five launch attributes: key:value, key=value, or a bare tag.
RP_ATTRIBUTE_1=env:staging
RP_ATTRIBUTE_2=release=24.3
RP_ATTRIBUTE_3=nightly

# Turn off the anonymous start event sent to Google Analytics.
AGENT_NO_ANALYTICS=1
